# Application
APP_NAME=terrion-backend
APP_ENV=development

# Web server (Fiber)
WEB_PORT=8080
WEB_PREFORK=false
# Comma-separated origins allowed by CORS
WEB_CORS_ORIGINS=http://localhost:3000

# Logging (logrus levels: 0=Panic 1=Fatal 2=Error 3=Warn 4=Info 5=Debug 6=Trace)
LOG_LEVEL=4

# Database (Supabase Postgres)
# Get these from your Supabase project: Project Settings -> Database.
# This targets the session pooler / direct connection (port 5432), NOT the
# transaction pooler (port 6543) — prepared statements stay enabled.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require
DB_POOL_IDLE=10
DB_POOL_MAX=100
DB_POOL_LIFETIME=300

# Redis (Upstash)
# Get this from your Upstash console: Database -> Connect -> "Redis" tab.
# Must use the rediss:// scheme (not redis://) so go-redis enables TLS.
REDIS_URL=

# Shared secret for the daily weather cron, sent as `Authorization: Bearer <secret>`
# to POST /api/cron/weather. Generate with: openssl rand -hex 32
CRON_SECRET=
